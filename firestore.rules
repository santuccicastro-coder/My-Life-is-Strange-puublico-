            'paymentMethod', 'accountOrCard', 'cardId', 'active', 'notes',
            'updatedByUid', 'updatedByName', 'updatedAt'
          ]);
        allow delete: if isAuthenticatedUser() && isValidId(householdId) && isValidId(itemId) && isHouseholdMember(householdId);
      }

