      }

      match /scenarios/{scenarioId} {
        allow get: if isSignedIn() && isValidId(householdId) && isValidId(scenarioId) && isHouseholdMember(householdId);
        allow list: if isSignedIn() && isHouseholdMember(householdId);
        allow create: if isAuthenticatedUser()
          && isValidId(householdId) && isValidId(scenarioId)
          && isValidScenario(incoming())
