            'updatedByUid', 'updatedByName', 'updatedAt'
          ]);
        allow delete: if isAuthenticatedUser() && isValidId(householdId) && isValidId(scenarioId) && isHouseholdMember(householdId);
      }

      match /aiMessages/{messageId} {
        allow get: if isSignedIn() && isValidId(householdId) && isValidId(messageId) && isHouseholdMember(householdId);
        allow list: if isSignedIn() && isHouseholdMember(householdId);
        allow create: if isAuthenticatedUser()
          && isValidId(householdId) && isValidId(messageId)
          && isValidAiMessage(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && isHouseholdMember(householdId);
        allow update: if false;
        allow delete: if isAuthenticatedUser() && isValidId(householdId) && isValidId(messageId) && isHouseholdMember(householdId);
      }

      match /bankAccounts/{accountId} {
        allow get: if isSignedIn() && isValidId(householdId) && isValidId(accountId) && isHouseholdMember(householdId);
        allow list: if isSignedIn() && isHouseholdMember(householdId);
        allow create: if isAuthenticatedUser()
          && isValidId(householdId) && isValidId(accountId)
          && isValidBankAccount(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().updatedByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isHouseholdMember(householdId);
        allow update: if isAuthenticatedUser()
          && isValidId(householdId) && isValidId(accountId)
          && isValidBankAccount(incoming())
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdByName == existing().createdByName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedByUid == request.auth.uid
