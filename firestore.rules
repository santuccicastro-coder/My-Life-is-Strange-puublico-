          && isHouseholdMember(householdId)
          && existsAfter(/databases/$(database)/documents/households/$(householdId)/goals/$(incoming().goalId))
          && getAfter(/databases/$(database)/documents/households/$(householdId)/goals/$(incoming().goalId)).data.updatedAt == request.time;
        allow update: if false;
        allow delete: if isAuthenticatedUser() && isValidId(householdId) && isValidId(movementId) && isHouseholdMember(householdId);
      }

      match /plannedPurchases/{purchaseId} {
        allow get: if isSignedIn() && isValidId(householdId) && isValidId(purchaseId) && isHouseholdMember(householdId);
        allow list: if isSignedIn() && isHouseholdMember(householdId);
        allow create: if isAuthenticatedUser()
          && isValidId(householdId) && isValidId(purchaseId)
          && isValidPlannedPurchase(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().updatedByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
