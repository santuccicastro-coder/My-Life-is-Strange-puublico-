def f(sz=10, b=False, c=TXT, i=False, u=None):
    return Font(name=FN, size=sz, bold=b, color=c, italic=i, underline=u)


def fl(c):
    return PatternFill("solid", fgColor=c)


def setc(ws, ref, value=None, font=None, fill=None, fmt=None, al=None, border=None):
    c = ws[ref]
    if value is not None:
        c.value = value
    c.font = font or f()
    if fill:
        c.fill = fl(fill)
    if fmt:
        c.number_format = fmt
    if al:
        c.alignment = al
    if border:
        c.border = border
    return c


def center(wrap=False):
    return Alignment(horizontal="center", vertical="center", wrap_text=wrap)


def left(wrap=False, indent=0):
    return Alignment(horizontal="left", vertical="center", wrap_text=wrap, indent=indent)


def right():
    return Alignment(horizontal="right", vertical="center")


wb = Workbook()
wb.remove(wb.active)


def sheet(name, tab, widths, last_col, title, subtitle, back=True):
    ws = wb.create_sheet(name)
    ws.sheet_properties.tabColor = tab
    ws.sheet_view.showGridLines = False
    for k, v in widths.items():
        ws.column_dimensions[k].width = v
    ws.row_dimensions[1].height = 36
    ws.row_dimensions[2].height = 20
    for ci in range(1, last_col + 1):
        ws.cell(1, ci).fill = fl(NAVY)
    setc(ws, "B1", title, f(16, True, "FFFFFF"), NAVY, al=left())
    if back:
        c = setc(ws, f"{L(last_col)}1", '=HYPERLINK("#\'Início\'!A1","← Início")',
                 f(10, True, "FFFFFF", u="single"), NAVY, al=right())
    setc(ws, "B2", subtitle, f(9, False, MUTED, True), al=left())
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    return ws


def header(ws, row, c1, labels, height=30):
    ws.row_dimensions[row].height = height
    for k, lab in enumerate(labels):
        setc(ws, f"{L(c1 + k)}{row}", lab, f(10, True, "FFFFFF"), NAVY, al=center(True), border=BOX)


def section(ws, ref, text, c1, c2):
    r = ws[ref].row
    for ci in range(c1, c2 + 1):
        ws.cell(r, ci).border = Border(bottom=Side(style="medium", color=BLUE))
    setc(ws, ref, text, f(10, True, NAVY), al=left())
    ws[ref].border = Border(bottom=Side(style="medium", color=BLUE))
    ws.row_dimensions[r].height = 22


def card(ws, r, c1, c2, label, formula, fmt, dark=False, sub=None, sub_fmt=None, vsize=16):
    bg = NAVY if dark else BG
    fc = "FFFFFF" if dark else NAVY
    lc = "CBD5E1" if dark else MUTED
    rows = [r, r + 1] + ([r + 2] if sub is not None else [])
    for rr in rows:
        for ci in range(c1, c2 + 1):
            ws.cell(rr, ci).fill = fl(bg)
        if c2 > c1:
            ws.merge_cells(start_row=rr, start_column=c1, end_row=rr, end_column=c2)
    a = L(c1)
    setc(ws, f"{a}{r}", label, f(9, True, lc), bg, al=Alignment(horizontal="left", vertical="center", indent=1))
    setc(ws, f"{a}{r+1}", formula, f(vsize, True, fc), bg, fmt, Alignment(horizontal="left", vertical="center", indent=1))
    ws.row_dimensions[r].height = 20
    ws.row_dimensions[r + 1].height = 34
    if sub is not None:
        setc(ws, f"{a}{r+2}", sub, f(9, False, lc), bg, sub_fmt, Alignment(horizontal="left", vertical="center", indent=1))
        ws.row_dimensions[r + 2].height = 18


def legend(ws, row, col):
    setc(ws, f"{L(col)}{row}", "Branco = você preenche", f(9, False, "0000FF"), "FFFFFF", al=center(), border=BOX)
    setc(ws, f"{L(col+1)}{row}", "Cinza = automático", f(9, False, MUTED), AUTO, al=center(), border=BOX)


def body(ws, r1, r2, specs, band=True):
    """specs: col_index -> dict(kind='in'|'auto', fmt, align)"""
    for r in range(r1, r2 + 1):
        for ci, s in specs.items():
            c = ws.cell(r, ci)
            auto = s.get("kind") == "auto"
            c.font = f(10, False, "000000" if auto else "0000FF")
            c.fill = fl(AUTO if auto else "FFFFFF")
            c.border = BOX
            if s.get("fmt"):
                c.number_format = s["fmt"]
            c.alignment = s.get("al", left())


def dv_list(ws, formula, rng, title="Valor inválido", msg="Escolha uma opção da lista."):
    d = DataValidation(type="list", formula1=formula, allow_blank=True, showErrorMessage=True,
                       errorTitle=title, error=msg)
    ws.add_data_validation(d)
    d.add(rng)


def band_rule(ws, rng):
    ws.conditional_formatting.add(rng, FormulaRule(formula=["MOD(ROW(),2)=0"], fill=fl("F8FAFC"), stopIfTrue=False))


def style_chart(ch, title, w, h):
    ch.title = title
    ch.roundedCorners = False
    ch.width, ch.height = w, h
    ch.legend.position = "b"
    ch.legend.overlay = False
    ch.title.overlay = False
    ch.x_axis.delete = False
    ch.y_axis.delete = False
    ch.y_axis.majorGridlines.spPr = None


