        "room",
        "product",
        "brandModel",
        "specs",
        "quantity",
        "estimatedUnitPrice",
        "actualUnitPrice",
        "hasActualPrice",
        "targetDate",
        "purchaseDate",
        "paymentMethod",
        "status",
        "notes",
        "createdByUid",
        "createdByName",
