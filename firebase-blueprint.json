  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfis privados dos usuários autenticados."
    },
    "/households/{householdId}": {
      "schema": { "$ref": "#/entities/Household" },
      "description": "Espaço financeiro compartilhado (máximo 7 membros)."
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Convites de uso único para ingressar em um espaço compartilhado."
    },
    "/households/{householdId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Lançamentos financeiros compartilhados."
    },
    "/households/{householdId}/recurringItems/{itemId}": {
      "schema": { "$ref": "#/entities/RecurringItem" },
      "description": "Ganhos e despesas fixas com projeção automática nos meses futuros."
    },
    "/households/{householdId}/incomes/{incomeId}": {
      "schema": { "$ref": "#/entities/Income" },
      "description": "Fontes de renda recorrentes ou extras."
    },
    "/households/{householdId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/Card" },
      "description": "Cartões de crédito cadastrados."
    },
