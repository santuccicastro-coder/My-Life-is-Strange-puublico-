        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "targetAmount",
        "currentAmount",
        "monthlyContribution",
        "annualYieldRate",
        "notes",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
