{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado do usuário autenticado (PII isolado).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "activeHouseholdId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "photoURL", "activeHouseholdId", "createdAt", "updatedAt"]
    },
    "Household": {
      "title": "Household",
      "description": "Espaço financeiro compartilhado entre até 7 pessoas.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberUids": { "type": "array", "description": "Lista de até 7 UIDs dos membros conectados." },
        "memberNames": { "type": "object", "description": "Mapa de UID para nome de exibição de cada membro conectado." },
        "partner1Uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "partner2Uid": { "type": "string", "maxLength": 128 },
        "partner1Name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "partner2Name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "periodStart": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-01$" },
        "categories": { "type": "array" },
        "expenseCategories": { "type": "array" },
        "incomeCategories": { "type": "array" },
        "categoryIcons": { "type": "object" },
        "paymentMethods": { "type": "array" },
        "rooms": { "type": "array" },
        "accounts": { "type": "array" },
        "lastInviteCode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "ownerUid",
        "memberUids",
        "partner1Uid",
        "partner2Uid",
        "partner1Name",
        "partner2Name",
        "periodStart",
        "categories",
        "paymentMethods",
        "rooms",
        "accounts",
        "lastInviteCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "Invite": {
      "title": "Invite",
      "description": "Convite de uso único para ingressar no espaço financeiro compartilhado (até 7 pessoas).",
      "type": "object",
      "properties": {
        "householdId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "householdName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "used": { "type": "boolean" },
        "usedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "usedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["householdId", "householdName", "createdByUid", "createdByName", "used", "usedByUid", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Lançamento financeiro (receita, despesa, economia ou transferência).",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Entrada", "Saída", "Economia", "Transferência"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 120 },
        "plannedAmount": { "type": "number" },
        "actualAmount": { "type": "number" },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "person": { "type": "string", "minLength": 1, "maxLength": 50 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "monthKey": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^\\d{4}-\\d{2}$" },
        "paymentMethod": { "type": "string", "minLength": 1, "maxLength": 40 },
        "accountOrCard": { "type": "string", "minLength": 1, "maxLength": 60 },
        "cardId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Pago", "Pendente"] },
        "dueDate": { "type": "string", "maxLength": 10 },
        "notes": { "type": "string", "maxLength": 300 },
        "recurringId": { "type": "string", "maxLength": 128 },
        "recurringMonthKey": { "type": "string", "maxLength": 7 },
        "entryKind": { "type": "string", "enum": ["padrao", "pagamento_fatura", "estorno"] },
        "refundTargetId": { "type": "string", "maxLength": 128 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "type",
        "description",
        "plannedAmount",
        "actualAmount",
        "category",
        "person",
        "date",
        "monthKey",
        "paymentMethod",
        "accountOrCard",
        "cardId",
        "status",
        "dueDate",
        "notes",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Income": {
      "title": "Income",
      "description": "Cadastro de salários, rendas recorrentes e rendas extras.",
      "type": "object",
      "properties": {
        "person": { "type": "string", "minLength": 1, "maxLength": 50 },
        "source": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["Mensal", "Quinzenal", "Semanal", "Única", "Anual"] },
        "receiptDay": { "type": "integer" },
        "receiptDate": { "type": "string", "maxLength": 10 },
        "active": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 300 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "person",
        "source",
        "amount",
        "frequency",
        "receiptDay",
        "receiptDate",
        "active",
        "notes",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Card": {
      "title": "Card",
      "description": "Cartão de crédito com limite, fechamento e vencimento.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "holder": { "type": "string", "minLength": 1, "maxLength": 50 },
        "limit": { "type": "number" },
        "closingDay": { "type": "integer" },
        "dueDay": { "type": "integer" },
        "color": { "type": "string", "minLength": 4, "maxLength": 20 },
        "active": { "type": "boolean" },
        "limitRule": { "type": "string", "enum": ["total_parcelamento", "parcela_mensal"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "holder",
        "limit",
        "closingDay",
        "dueDay",
        "color",
        "active",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Installment": {
      "title": "Installment",
      "description": "Compra parcelada distribuída nos meses seguintes.",
      "type": "object",
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cardId": { "type": "string", "maxLength": 128 },
        "cardName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "person": { "type": "string", "minLength": 1, "maxLength": 50 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "totalAmount": { "type": "number" },
        "installmentsCount": { "type": "integer" },
        "firstChargeDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "paidInstallmentNumbers": {
          "type": "array",
          "description": "Lista opcional de números das parcelas pagas individualmente (1..120)."
        },
        "prepaidInstallmentNumbers": {
          "type": "array",
          "description": "Lista opcional de números das parcelas antecipadas/quitadas antes do vencimento."
        },
        "cancelledInstallmentNumbers": {
          "type": "array",
          "description": "Lista opcional de números das parcelas canceladas/estornadas."
        },
        "refundedAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Ativo", "Quitado", "Cancelado"] },
        "notes": { "type": "string", "maxLength": 300 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "description",
        "cardId",
        "cardName",
        "person",
        "category",
        "totalAmount",
        "installmentsCount",
        "firstChargeDate",
        "notes",
        "createdByUid",
        "createdByName",
        "updatedByUid",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Goal": {
      "title": "Goal",
      "description": "Meta financeira / reserva de economia com rendimento e projeção.",
